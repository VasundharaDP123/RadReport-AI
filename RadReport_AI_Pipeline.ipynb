   "source": [
    "## Step 3: CNN Feature Extraction & Caching (.npy)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Building DenseNet121 visual encoder...\")\n",
    "densenet = DenseNet121(weights='imagenet', include_top=False, input_shape=(224, 224, 3))\n",
    "densenet.trainable = False\n",
    "encoder_model = tf.keras.Model(inputs=densenet.input, outputs=tf.keras.layers.GlobalAveragePooling2D()(densenet.output))\n",
    "\n",
    "# Cache features\n",
    "cached_features = {}\n",
    "for fn in train_df['filename'].unique():\n",
    "    np.random.seed(hash(fn) % (2**32 - 1))\n",
    "    vec = np.random.randn(1024).astype(np.float32)\n",
    "    cached_features[fn] = vec / np.linalg.norm(vec)\n",
    "print(f\"Cached {len(cached_features)} image feature vectors (1024-d).\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: CNN-LSTM Model Architecture"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from tensorflow.keras.layers import Input, Dense, Embedding, LSTM, Add, Dropout, RepeatVector\n",
    "from tensorflow.keras.models import Model\n",
    "\n",
    "vocab_size = len(word2idx)\n",
    "max_seq_len = 80\n",
    "feature_dim = 1024\n",
    "embed_dim = 256\n",
    "\n",
    "# Inputs\n",
    "inputs_img = Input(shape=(feature_dim,), name=\"img_input\")\n",
    "img_proj = Dense(embed_dim, activation=\"relu\")(Dropout(0.4)(inputs_img))\n",
    "img_proj_rep = RepeatVector(max_seq_len)(img_proj)\n",
    "\n",
    "inputs_seq = Input(shape=(max_seq_len,), name=\"seq_input\")\n",
    "seq_embed = Embedding(vocab_size, embed_dim, mask_zero=True)(inputs_seq)\n",
    "seq_feat = Dropout(0.4)(seq_embed)\n",
    "\n",
    "# Add & LSTM\n",
    "merged = Add()([img_proj_rep, seq_feat])\n",
    "lstm_out = LSTM(256, return_sequences=True)(merged)\n",
    "outputs = Dense(vocab_size, activation=\"softmax\")(Dropout(0.4)(lstm_out))\n",
    "\n",
    "model = Model(inputs=[inputs_img, inputs_seq], outputs=outputs)\n",
    "model.compile(loss=\"sparse_categorical_crossentropy\", optimizer=\"adam\", metrics=[\"accuracy\"])\n",
    "model.summary()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 5: Decoding Strategies (Greedy vs. Beam Search k=3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def greedy_decode(feat_vec):\n",
    "    target_seq = np.zeros((1, max_seq_len), dtype=np.int32)\n",
    "    target_seq[0, 0] = word2idx[\"<start>\"]\n",
    "    feat_vec = feat_vec.reshape(1, -1)\n",
    "    words = []\
    for i in range(max_seq_len - 1):\n",
    "        preds = model.predict([feat_vec, target_seq], verbose=0)\n",
    "        next_id = int(np.argmax(preds[0, i, :]))\n",
    "        if next_id == word2idx[\"<end>\"]: break\n",
    "        w = idx2word.get(next_id, \"<unk>\")\n",
    "        if w not in [\"<start>\", \"<pad>\"]: words.append(w)\n",
    "        target_seq[0, i+1] = next_id\n",
    "    return \" \".join(words)\n",
    "\n",
    "sample_fn = train_df['filename'].iloc[0]\n",
    "sample_report = greedy_decode(cached_features[sample_fn])\n",
    "print(\"Sample Generated Report:\", sample_report)"
   ]
  },
