   "source": [
    "## Step 2: Data Preprocessing & Patient-Wise Split (Data Leakage Mitigation)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class RadiologyDataPreprocessor:\
    def __init__(self, min_word_count=3, max_seq_len=80):\
        self.min_word_count = min_word_count\
        self.max_seq_len = max_seq_len\
        self.word2idx, self.idx2word = {}, {}\
        self.START_TOKEN, self.END_TOKEN = \"<start>\", \"<end>\"\
        self.PAD_TOKEN, self.UNK_TOKEN = \"<pad>\", \"<unk>\"\
\
    def clean_text(self, text):\
        if pd.isna(text) or not isinstance(text, str): return \"\"\
        text = text.lower()\
        text = re.sub(r'x{2,}', '', text)\
        text = re.sub(r'\\bxxxx\\b', '', text)\
        text = re.sub(r'[^a-z0-9\\.\\s]', ' ', text)\
        text = re.sub(r'\\s+', ' ', text).strip()\
        text = re.sub(r'\\.', ' . ', text)\
        text = re.sub(r'\\s+', ' ', text).strip()\
        if not text: return \"\"\
        return f\"{self.START_TOKEN} {text} {self.END_TOKEN}\"\
\
    def patient_wise_split(self, df):\
        unique_uids = df['uid'].unique()\
        train_uids, temp_uids = train_test_split(unique_uids, test_size=0.2, random_state=42)\
        val_uids, test_uids = train_test_split(temp_uids, test_size=0.5, random_state=42)\
        return df[df['uid'].isin(train_uids)], df[df['uid'].isin(val_uids)], df[df['uid'].isin(test_uids)]\
\
    def build_vocabulary(self, train_texts):\
        counts = {}\
        for text in train_texts:\
            for token in text.split():\
                counts[token] = counts.get(token, 0) + 1\
        vocab = [self.PAD_TOKEN, self.UNK_TOKEN, self.START_TOKEN, self.END_TOKEN]\
        for w, c in sorted(counts.items(), key=lambda x: -x[1]):\
            if c >= self.min_word_count and w not in vocab:\
                vocab.append(w)\
        self.word2idx = {w: i for i, w in enumerate(vocab)}\
        self.idx2word = {i: w for i, w in enumerate(vocab)}\
        return self.word2idx, self.idx2word\n",
    "\n",
    "preprocessor = RadiologyDataPreprocessor()\n",
    "# Load synthetic dataset if Kaggle dataset CSVs not present\n",
    "if os.path.exists('indiana_reports.csv') and os.path.exists('indiana_projections.csv'):\
        reports = pd.read_csv('indiana_reports.csv')\
        projections = pd.read_csv('indiana_projections.csv')\
        df = pd.merge(reports, projections, on='uid')\
        df = df[df['projection'].str.lower() == 'frontal'].copy()\
        df['cleaned_findings'] = df['findings'].apply(preprocessor.clean_text)\
        df = df[df['cleaned_findings'] != \"\"].copy()\
    else:\
        print(\"[Demo Mode] Using generated dataset samples...\")\
        data = [{'uid': f'p_{i//2}', 'filename': f'img_{i}.png', 'cleaned_findings': preprocessor.clean_text('the heart size and pulmonary vascularity appear within normal limits . no focal consolidation .')} for i in range(200)]\
        df = pd.DataFrame(data)\n",
    "\n",
    "train_df, val_df, test_df = preprocessor.patient_wise_split(df)\n",
    "word2idx, idx2word = preprocessor.build_vocabulary(train_df['cleaned_findings'])\n",
    "print(f\"Vocabulary Size: {len(word2idx)} words. Train: {len(train_df)}, Val: {len(val_df)}, Test: {len(test_df)}\")"
   ]
  },
